{
    "name": "netresearch/typo3-ci-workflows",
    "description": "Centralized dev-dependencies, configs, and CI tooling for Netresearch TYPO3 extensions",
    "type": "library",
    "license": "MIT",
    "bin": [
        "assets/Build/Scripts/runTests.sh"
    ],
    "autoload": {
        "psr-4": {
            "Netresearch\\Typo3CiWorkflows\\": "src/"
        }
    },
    "require": {
        "php": "^8.2",
        "a9f/typo3-fractor": "^1.0",
        "captainhook/captainhook": "^5.28",
        "captainhook/hook-installer": "^1.0",
        "dg/bypass-finals": "^1.9",
        "ergebnis/composer-normalize": "^2.0",
        "ergebnis/phpstan-rules": "^2.6",
        "friendsofphp/php-cs-fixer": "^3.65",
        "giorgiosironi/eris": "^1.0",
        "infection/infection": ">=0.29 <1.0",
        "nikic/php-fuzzer": ">=0.0.11 <1.0",
        "overtrue/phplint": "^9.5",
        "phpat/phpat": ">=0.12 <1.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "rector/rector": "^2.0",
        "saschaegerer/phpstan-typo3": "^2.0 || ^3.0",
        "ssch/typo3-rector": "^3.15.1",
        "typo3/testing-framework": ">=8.3.3 <11"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "a9f/fractor-extension-installer": true,
            "captainhook/hook-installer": true,
            "dg/bypass-finals": true,
            "infection/extension-installer": true,
            "phpstan/extension-installer": true,
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        }
    }
}
