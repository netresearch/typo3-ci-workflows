# Parameters shared by both PHPStan entry points of this package.
#
# phpstan.neon includes this file and adds the rule configuration
# (strictness flags, ergebnis rules, ignoreErrors). phpstan-rector.neon
# includes only this file, because Rector's bundled PHPStan does not know
# the ergebnis schema. A parameter that both runs need goes here, once.
#
# Consumers do not include this file directly.

parameters:
    level: 10

    treatPhpDocTypesAsCertain: false
    inferPrivatePropertyTypeFromConstructor: true

    excludePaths:
        # Both vendor-dir spellings in use across the org (.Build and .build).
        # Wildcard patterns are exempt from PHPStan's path-existence check, so
        # listing the variant a repo does not use is harmless (verified on
        # PHPStan 2.2.7).
        - %currentWorkingDirectory%/.Build/*
        - %currentWorkingDirectory%/.build/*
        - %currentWorkingDirectory%/ext_emconf.php

    bootstrapFiles:
        # Relative to THIS file (PHPStan resolves relative paths against the
        # config file that declares them), so it works for any vendor-dir the
        # consuming repo uses — the previous absolute form hardcoded .Build
        # and broke every .build repo.
        - stubs/phpunit-attributes.php
