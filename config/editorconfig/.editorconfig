# Template for an extension's .editorconfig.
#
# Copy it to the repository root. The [*] section is what all 17 extensions
# in the org with an .editorconfig set; the sections below follow the
# majority of them.

root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{json,yaml,yml}]
indent_size = 2

[*.{xlf,xliff}]
indent_size = 2

[Makefile]
indent_style = tab
