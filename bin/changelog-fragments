#!/usr/bin/env php
<?php

/*
 * Checks and collects CHANGELOG fragments in changelog.d/.
 *
 * A pull request writes its CHANGELOG entry into its own file
 * changelog.d/<branch-slug>.<section>.md instead of editing the shared
 * "## [Unreleased]" section, because two pull requests that both edit that
 * section conflict as soon as one of them merges.
 *
 *   check    Refuse a malformed fragment, and refuse fragments while the
 *            topmost released section has no tag yet: either the release
 *            commit skipped collect, and those notes would not ship, or the
 *            release is merged and its tag is not pushed yet.
 *   collect  Append every fragment under its heading in "## [Unreleased]" and
 *            delete the fragment. The release commit runs this before it
 *            renames [Unreleased]. Running it with no fragments changes
 *            nothing.
 *
 * The file names follow towncrier's <name>.<type>.md scheme. towncrier renders
 * a complete versioned section at a marker; it has no documented mode that
 * appends to an existing [Unreleased] section.
 *
 * Usage: changelog-fragments check|collect [<repository root>]
 *
 * The repository root defaults to the working directory, which is the project
 * root when Composer runs the command from a script.
 *
 * Exit 0 on success, 1 when a fragment or the changelog is not ready, 2 on a
 * usage error or when a file cannot be read, written or deleted.
 */

declare(strict_types=1);

/** Fragment type => CHANGELOG heading, in the order headings appear. */
const SECTIONS = [
    'upgrading'  => null,
    'added'      => '### Added',
    'changed'    => '### Changed',
    'deprecated' => '### Deprecated',
    'removed'    => '### Removed',
    'fixed'      => '### Fixed',
    'security'   => '### Security',
];

/** The upgrading heading before a version is appended to it. */
const UPGRADING = '### Upgrading';

/** What "git rev-parse --local-env-vars" lists (git 2.56.1). */
const LOCAL_GIT_VARIABLES = [
    'GIT_ALTERNATE_OBJECT_DIRECTORIES',
    'GIT_CONFIG',
    'GIT_CONFIG_PARAMETERS',
    'GIT_CONFIG_COUNT',
    'GIT_OBJECT_DIRECTORY',
    'GIT_DIR',
    'GIT_WORK_TREE',
    'GIT_IMPLICIT_WORK_TREE',
    'GIT_GRAFT_FILE',
    'GIT_INDEX_FILE',
    'GIT_NO_REPLACE_OBJECTS',
    'GIT_REPLACE_REF_BASE',
    'GIT_PREFIX',
    'GIT_SHALLOW_FILE',
    'GIT_COMMON_DIR',
];

const NAME_PATTERN = '/^[a-z0-9][a-z0-9._-]*\.(upgrading|added|changed|deprecated|removed|fixed|security)\.md$/';

$args = array_slice($argv, 1);
$mode = $args[0] ?? '';
$root = $args[1] ?? (string) getcwd();

foreach ($args as $arg) {
    if (str_starts_with($arg, '-')) {
        fwrite(STDERR, sprintf("changelog-fragments: unknown option %s\n", $arg));

        exit(2);
    }
}

if (!in_array($mode, ['check', 'collect'], true) || count($args) > 2) {
    fwrite(STDERR, "usage: changelog-fragments check|collect [<repository root>]\n");

    exit(2);
}

$dir           = $root . '/changelog.d';
$changelogPath = $root . '/CHANGELOG.md';

if (!is_readable($changelogPath)) {
    fwrite(STDERR, sprintf("changelog-fragments: cannot read %s\n", $changelogPath));

    exit(2);
}

/**
 * Read the fragments, sorted by file name.
 *
 * @param list<string> $problems
 *
 * @return list<array{file: string, type: string, text: string}>
 */
function readFragments(string $dir, array &$problems): array
{
    // A checked-in symbolic link would let collect read and delete files
    // outside the repository.
    if (is_link($dir)) {
        $problems[] = '  changelog.d  is a symbolic link; it must be a directory of the repository';

        return [];
    }

    if (!is_dir($dir)) {
        return [];
    }

    $names = scandir($dir);

    if ($names === false) {
        fwrite(STDERR, sprintf("changelog-fragments: cannot list %s\n", $dir));

        exit(2);
    }

    sort($names, SORT_STRING);
    $fragments = [];

    foreach ($names as $name) {
        if ($name === '.' || $name === '..' || $name === 'README.md') {
            continue;
        }

        $path = $dir . '/' . $name;

        if (is_link($path)) {
            $problems[] = sprintf('  %s  is a symbolic link; write the fragment as a file', $name);

            continue;
        }

        if (preg_match(NAME_PATTERN, $name, $m) !== 1 || !is_file($path)) {
            $problems[] = sprintf('  %s  is not named <branch-slug>.<%s>.md', $name, implode('|', array_keys(SECTIONS)));

            continue;
        }

        $raw = file_get_contents($path);

        if ($raw === false) {
            fwrite(STDERR, sprintf("changelog-fragments: cannot read %s\n", $path));

            exit(2);
        }

        $text = trim(str_replace("\r\n", "\n", $raw));

        if (!str_starts_with($text, '- ')) {
            $problems[] = sprintf('  %s  must start with a top-level bullet ("- ")', $name);

            continue;
        }

        if (preg_match('/^#/m', $text) === 1) {
            $problems[] = sprintf('  %s  must not contain a heading; the file name selects the heading', $name);

            continue;
        }

        // An underline of "=" or "-" turns the line above into a heading, and
        // on its own line it is a horizontal rule; either splits the section.
        if (preg_match('/^ {0,3}(=+|-+)[ \t]*$/m', $text) === 1) {
            $problems[] = sprintf('  %s  must not contain a heading underline or a horizontal rule', $name);

            continue;
        }

        // Such a line ends the [Unreleased] section for collect(), and its
        // destination may follow on the next line.
        if (preg_match('/^ {0,3}\[[^\]]+\]:(\s|$)/m', $text) === 1) {
            $problems[] = sprintf('  %s  must not contain a link definition; write the link inline', $name);

            continue;
        }

        $fragments[] = ['file' => $path, 'type' => $m[1], 'text' => $text];
    }

    return $fragments;
}

/**
 * The version of the topmost released section, or null when there is none.
 */
function topmostReleased(string $changelog): ?string
{
    // A version number, so a "## [0.x] - Legacy" line is no release.
    return preg_match('/^## \[(\d+\.\d+(?:\.\d+)?(?:[-+][^\]]*)?)\]/m', $changelog, $m) === 1 ? $m[1] : null;
}

/**
 * Whether tag v$version exists, locally or on origin.
 *
 * A shallow CI checkout carries no tags, so origin is asked with ls-remote. It
 * fetches nothing, so it cannot turn a full clone into a shallow one. Without
 * an origin there is nothing else to ask. A failing ls-remote stops the check
 * with its own message, because reporting it as a missing tag would name the
 * wrong cause.
 */
function tagExists(string $root, string $version): bool
{
    $ref = 'refs/tags/v' . $version;

    if (run(['git', '-C', $root, 'rev-parse', '--quiet', '--verify', $ref])) {
        return true;
    }

    if (!run(['git', '-C', $root, 'remote', 'get-url', 'origin'])) {
        return false;
    }

    $listed = '';

    if (!run(['git', '-C', $root, 'ls-remote', '--tags', 'origin', $ref], $listed)) {
        fwrite(
            STDERR,
            sprintf(
                "changelog-fragments: cannot ask origin whether tag v%s exists. Check the remote and run the check again.\n",
                $version,
            ),
        );

        exit(2);
    }

    return trim($listed) !== '';
}

/**
 * @param list<string> $command
 */
function run(array $command, string &$stdout = ''): bool
{
    // nosemgrep: netresearch.php.lang.security.exec-use.exec-use - argv array, no shell; every caller passes literal git arguments plus this repository's own root and a version read from its CHANGELOG
    $proc = proc_open($command, [1 => ['pipe', 'w'], 2 => ['file', '/dev/null', 'w']], $pipes, null, gitEnvironment());

    if (!is_resource($proc)) {
        return false;
    }

    // stderr goes to /dev/null rather than into a pipe: a transport that
    // filled a pipe nobody reads yet would block before it closes stdout.
    $stdout = (string) stream_get_contents($pipes[1]);
    fclose($pipes[1]);

    return proc_close($proc) === 0;
}

/**
 * The environment without git's repository-local variables.
 *
 * A hook of a linked worktree runs with GIT_DIR and GIT_INDEX_FILE set, and
 * both override "git -C": the tag would be looked up in that repository.
 *
 * @return array<string, string>
 */
function gitEnvironment(): array
{
    return array_diff_key(getenv(), array_flip(LOCAL_GIT_VARIABLES));
}

/**
 * The upgrading heading of the section: the one that is there, or the one that
 * names the last released minor version.
 *
 * @param list<string> $heads
 */
function upgradingHeading(array $heads, ?string $released): string
{
    foreach ($heads as $head) {
        if (str_starts_with($head, UPGRADING)) {
            return $head;
        }
    }

    if ($released !== null && preg_match('/^(\d+\.\d+)/', $released, $v) === 1) {
        return '### Upgrading from ' . $v[1];
    }

    return UPGRADING;
}

/**
 * The position of a heading in SECTIONS order, or null for any other heading.
 */
function headingRank(string $head): ?int
{
    if (str_starts_with($head, UPGRADING)) {
        return 0;
    }

    $rank = array_search($head, array_values(SECTIONS), true);

    return $rank === false ? null : $rank;
}

/**
 * The block index at which a missing heading is inserted: before the first
 * heading that follows it in SECTIONS order, otherwise at the end.
 *
 * @param list<string> $heads
 */
function insertionIndex(array $heads, string $heading): int
{
    $want = (int) headingRank($heading);

    foreach ($heads as $i => $head) {
        $have = headingRank($head);

        if ($i > 0 && $have !== null && $have > $want) {
            return $i;
        }
    }

    return count($heads);
}

/**
 * Where the [Unreleased] section at the start of $rest ends: at the next
 * level-1 or level-2 heading or link definition at the start of a line,
 * outside fenced code. A release history kept in another format ("# 5.1.1",
 * "## 3.28.11 (2026-11-25)") below [Unreleased] therefore stays where it is,
 * and a "# comment" in a fenced shell example does not end the section.
 */
function sectionEnd(string $rest): int
{
    $offset = 0;
    $fence  = null;

    foreach (preg_split('/(?<=\n)/', $rest) ?: [] as $i => $line) {
        if ($fence !== null) {
            if (preg_match('/^ {0,3}' . preg_quote($fence[0], '/') . '{' . strlen($fence) . ',}[ \t]*\r?$/', rtrim($line, "\n")) === 1) {
                $fence = null;
            }
        } elseif (preg_match('/^ {0,3}(`{3,}|~{3,})/', $line, $m) === 1) {
            $fence = $m[1];
        } elseif ($i > 0 && preg_match('/^(##? (?!\[Unreleased\])|\[[^\]]+\]: \S)/', $line) === 1) {
            return $offset;
        }

        $offset += strlen($line);
    }

    return strlen($rest);
}

/**
 * Append the fragments to the `[Unreleased]` section of $changelog.
 *
 * The section is split into blocks at its `### ` headings; a fragment is
 * appended to the end of the block with its heading, and a missing heading is
 * inserted in SECTIONS order.
 *
 * @param list<array{file: string, type: string, text: string}> $fragments
 */
function collect(string $changelog, array $fragments): ?string
{
    $start = strpos($changelog, '## [Unreleased]');

    if ($start === false) {
        return null;
    }

    $rest    = substr($changelog, $start);
    $end     = sectionEnd($rest);
    $section = substr($rest, 0, $end);

    // Block 0 is the heading line plus anything above the first `### `.
    $blocks = preg_split('/^(?=### )/m', $section) ?: [$section];

    // Trimmed, so a CRLF checkout or a trailing space still matches its heading.
    $heads = array_map(static fn (string $b): string => rtrim(strtok($b, "\n") ?: ''), $blocks);

    $upgrading = upgradingHeading($heads, topmostReleased($changelog));

    foreach ($fragments as $fragment) {
        $heading = SECTIONS[$fragment['type']] ?? $upgrading;
        $index   = array_search($heading, $heads, true);

        if ($index === false) {
            $index = insertionIndex($heads, $heading);

            $blocks[$index - 1] = rtrim($blocks[$index - 1], "\r\n") . "\n\n";
            array_splice($blocks, $index, 0, [$heading . "\n"]);
            array_splice($heads, $index, 0, [$heading]);
        }

        $blocks[$index] = rtrim($blocks[$index], "\r\n") . "\n\n" . $fragment['text'] . "\n\n";
    }

    return substr($changelog, 0, $start) . implode('', $blocks) . substr($rest, $end);
}

$problems  = [];
$fragments = readFragments($dir, $problems);
$changelog = file_get_contents($changelogPath);

if ($changelog === false) {
    fwrite(STDERR, sprintf("changelog-fragments: cannot read %s\n", $changelogPath));

    exit(2);
}

if ($mode === 'check') {
    $released = topmostReleased($changelog);

    if ($fragments !== [] && $released !== null && !tagExists($root, $released)) {
        $problems[] = sprintf(
            '  [%s] has no tag v%s yet, and %d fragment(s) are left. In the release commit, run `composer changelog:collect` before renaming [Unreleased], or the release ships without their notes. If the release is already merged, push tag v%s and run the check again.',
            $released,
            $released,
            count($fragments),
            $released,
        );
    }
}

if ($problems !== []) {
    fwrite(
        STDERR,
        sprintf(
            "changelog.d/ is not ready:\n\n%s\n\nSee changelog.d/README.md for the format.\n",
            implode("\n", $problems),
        ),
    );

    exit(1);
}

if ($mode === 'check') {
    fwrite(STDOUT, sprintf("changelog-fragments: %d fragment(s) ok\n", count($fragments)));

    exit(0);
}

if ($fragments === []) {
    fwrite(STDOUT, "changelog-fragments: nothing to collect\n");

    exit(0);
}

$collected = collect($changelog, $fragments);

if ($collected === null) {
    fwrite(STDERR, sprintf("changelog-fragments: %s has no ## [Unreleased] section to collect into\n", $changelogPath));

    exit(1);
}

// The new changelog is written beside the old one and renamed over it only
// once it is complete, so a failed or short write leaves CHANGELOG.md as it
// was. The fragments are deleted only after the rename. tempnam() creates a
// file of its own, so an existing path (a symlink a pull request checked in)
// is never opened. It creates the file with mode 0600, so the changelog's
// mode is copied before the rename. When the directory is not writable it
// falls back to the system temp directory, and the rename into the directory
// then fails, which the cleanup below handles.
$temporary = tempnam(dirname($changelogPath), 'CHANGELOG.md.collect.');
$written   = $temporary !== false && file_put_contents($temporary, $collected) === strlen($collected) && chmod($temporary, fileperms($changelogPath) & 0o777) && rename($temporary, $changelogPath);

if (!$written) {
    if (is_string($temporary) && is_file($temporary)) {
        // nosemgrep: php.lang.security.unlink-use.unlink-use - the temporary file this script just created beside CHANGELOG.md
        unlink($temporary);
    }

    fwrite(
        STDERR,
        sprintf("changelog-fragments: cannot write %s; it and the fragments are unchanged.\n", $changelogPath),
    );

    exit(2);
}

// A fragment left behind would be collected a second time by the next run,
// so a failed deletion is an error that names every file still to remove.
$kept = [];

foreach ($fragments as $fragment) {
    // nosemgrep: php.lang.security.unlink-use.unlink-use - a fragment file this script just read from the repository's own changelog.d/ and validated by name
    if (!unlink($fragment['file'])) {
        $kept[] = $fragment['file'];
    }
}

if ($kept !== []) {
    fwrite(
        STDERR,
        sprintf(
            "changelog-fragments: %s now holds the fragments, but %d could not be deleted. Delete them before the next run, or it adds their entries again:\n  %s\n",
            $changelogPath,
            count($kept),
            implode("\n  ", $kept),
        ),
    );

    exit(2);
}

fwrite(STDOUT, sprintf("changelog-fragments: collected %d fragment(s) into [Unreleased]\n", count($fragments)));

exit(0);
