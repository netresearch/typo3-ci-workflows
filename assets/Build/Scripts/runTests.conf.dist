# Per-extension settings for the shared test runner (.Build/bin/runTests.sh).
#
# Copy to Build/Scripts/runTests.conf and set only what differs from the
# defaults shown. The file is sourced by the runner, so it is plain bash; the
# environment still wins, which is what makes a one-off override possible
# without editing anything:
#
#   DEFAULT_PHP_VERSION=8.2 Build/Scripts/runTests.sh -s unit   # default is 8.5
#
# An extension that needs something this file cannot express is telling you the
# shared runner is missing a knob — add it there rather than forking the runner.

# Container network prefix and the name in `-h` output. Both are read from
# composer.json — the package name for the slug, extra.typo3/cms.extension-key
# for the label — so there is normally nothing to set here. Override only if
# the extension wants a name it does not declare anywhere.
#PROJECT_SLUG="nr-llm"
#PROJECT_LABEL="nr_llm"

# Almost nothing needs to be here. The runner reads composer.json for the
# vendor and bin directories and for the PHP version to default to, looks for
# the PHPUnit / PHPStan / Rector / Infection configs in the places extensions
# actually keep them — including the php-cs-fixer config, which php-cs-fixer
# itself only finds in the project root — reads the testsuite names out of the
# PHPUnit config, and
# derives the sharded functional run's directories from that config's own
# testsuites. Set something below only where an extension differs from what
# can be found — and prefer moving the file to where it is looked for.
#
#PHPUNIT_CONFIG="Build/phpunit.xml"
#PHPUNIT_FUNCTIONAL_CONFIG="Build/FunctionalTests.xml"
#PHPSTAN_CONFIG="Build/phpstan/phpstan.neon"
#CGL_CONFIG="Build/php-cs-fixer.php"
#RECTOR_CONFIG="Build/rector/rector.php"
#INFECTION_CONFIG="infection.json.dist"
#
# Testsuite names are matched loosely against the config ("unit" finds "Unit
# Tests"), and a config with a single suite is run whole. Set one to override
# that, or to "" to force running the whole config.
#UNIT_TESTSUITE="unit"
#FUNCTIONAL_TESTSUITE="functional"
#FUZZY_TESTSUITE="fuzz"
#INTEGRATION_TESTSUITE="integration"
#
# The shard list must cover every directory the functional config's testsuites
# name — a directory in the config but not here runs in no job and still reads
# as covered (#272, #658). It is derived from that config; set it only if the
# derivation is wrong, and say why.
#FUNCTIONAL_PARALLEL_PATHS="Tests/Functional Tests/E2E/Backend"
#
# The default PHP is the newest this runner has images for that the
# extension's own require.php allows. Set this to pin something else.
#DEFAULT_PHP_VERSION="8.5"

# Where `-s e2e` points its browser, when TYPO3_BASE_URL is not in the
# environment. The runner starts no TYPO3 and does not care what serves this —
# a local stack, a staging system, anything answering. There is no default on
# purpose: a guessed URL means testing against whatever happens to answer.
#E2E_BASE_URL="https://your-typo3.local"

# …or let the run build one. `-s e2e` can install a TYPO3 of its own —
# MariaDB, a composer-installed instance with this extension required from a
# path repository, PHP-FPM and Apache — and point the browser at it. Nothing
# else in this file is then needed for the address.
#
# The instance is TYPO3 13 unless E2E_TYPO3_VERSION says otherwise. Prefer that
# variable over `-t 14`: `-t` is not suite-gated, so it rewrites the extension's
# composer.json and runs a `composer require` before provisioning even starts.
#
# It is thrown away when the suite passes and kept at .Build/e2e-typo3 when it
# fails, logs included.
#E2E_PROVISION=1

# Four hooks shape that instance, all optional. Defining ANY of them switches
# provisioning on by itself, so E2E_PROVISION is only needed by a consumer that
# defines none — a suite that drives the backend and needs no content.
#
# What to require beyond the extension itself. Called with the variant in
# ${E2E_VARIANT} and the TYPO3 constraint in ${E2E_TYPO3_CONSTRAINT}:
#
#e2e_provision_packages() {
#    printf '%s' "typo3/cms-lowlevel friendsoftypo3/tt-address:^7"
#}
#
# TypoScript for the root template. Write ts-constants.typoscript and/or
# ts-setup.typoscript into ${E2E_SCRIPTS}; both land in the root sys_template.
# Without this the runner writes a minimal page object, because provisioning
# ends by requiring HTTP 200 from the frontend and a template without one
# answers 500:
#
#e2e_provision_typoscript() {
#    cat > "${E2E_SCRIPTS}/ts-setup.typoscript" << 'TYPOSCRIPT'
#page = PAGE
#page.10 = FLUIDTEMPLATE
#page.10.file = EXT:my_ext/Resources/Private/Templates/Page.html
#TYPOSCRIPT
#}
#
# `dependencies:` entries for the site configuration, one per line, indented by
# two spaces. A site set only resolves when the extension providing it is
# installed, so this follows the same variant logic as the packages:
#
#e2e_provision_site_dependencies() {
#    printf '  - my-vendor/my-ext\n'
#}
#
# Demo content, after TYPO3 is installed and the schema exists. This runs on
# the HOST, not in a container: ${E2E_ROOT} is the instance directory and is
# writable from here, and anything that needs PHP starts its own container the
# way provisioning does. ${E2E_SCRIPTS} holds the mounted helper scripts:
#
#e2e_provision_seed() {
#    php "${E2E_SCRIPTS}/my-seed.php" || return 1
#}

# When the target does not exist until the run creates it — an extension that
# starts its own web container per run, whose hostname carries that run's
# suffix — print the URL from a function instead. It runs after the runner's
# own setup, and TYPO3_BASE_URL from the environment still wins over it:
#
#e2e_target() {
#    start_my_stack >&2            # anything this needs, output to stderr
#    printf '%s' "http://my-web-${SUFFIX}:80"
#}

# When the e2e container cannot reach that URL on its own, the arguments to
# add can also come from outside this file — E2E_CONTAINER_ARGS in the
# environment. That is where local glue belongs: a ddev command knows ddev is
# running, this file only knows it was written on a machine where it was.
#
# Only when the extension itself has to compute them — a target
# behind another container network, a name that resolves only there. Print the
# arguments to add to the container; the runner adds nothing by itself and
# knows no environment by name. Example for a local ddev site, which lives on
# its own network:
#
#e2e_container_args() {
#    local ip
#    ip=$(${CONTAINER_BIN} inspect ddev-router \
#        --format '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' 2>/dev/null) || return 0
#    [ -n "${ip}" ] || return 0
#    printf '%s' "--network ddev_default --add-host your-typo3.ddev.site:${ip}"
#}

# When e2e_target() created something the runner cannot know about, take it
# down here. Containers do NOT need this — the runner removes everything
# attached to its network at the end, whoever started it. Run-scoped FILES do:
# a TYPO3 instance directory is worth keeping when the suite failed and worth
# deleting when it passed, and this is the only point that knows which
# happened. ${SUITE_EXIT_CODE} holds the result.
#
#e2e_teardown() {
#    if [ "${SUITE_EXIT_CODE}" -eq 0 ]; then
#        rm -rf .Build/e2e-instance
#    else
#        echo "e2e environment kept at .Build/e2e-instance" >&2
#    fi
#}

# The Playwright image for `-s e2e`.
#IMAGE_PLAYWRIGHT="mcr.microsoft.com/playwright:v1.60.0-noble"

# Composer needs a root version for a package that has no tag in its own
# checkout; only change this if the extension's branch alias differs.
#COMPOSER_ROOT_VERSION="0.1.x-dev"

# A suite the shared runner does not have — rendering this extension's
# documentation, publishing coverage, installing the lowest supported
# dependency set. Define it here and `-s <name>` calls it with the remaining
# arguments; the runner's own suites always win over a function of the same
# name, so this extends rather than overrides.
#
#suite_renderDocumentation() {
#    ${CONTAINER_BIN} run ${CONTAINER_COMMON_PARAMS} --name docs-${SUFFIX} \
#        ghcr.io/typo3-documentation/render-guides:latest --config=Documentation
#}
