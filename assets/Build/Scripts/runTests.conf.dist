# Per-extension settings for the shared test runner (.Build/bin/runTests.sh).
#
# Copy to Build/Scripts/runTests.conf and set only what differs from the
# defaults shown. The file is sourced by the runner, so it is plain bash; the
# environment still wins, which is what makes a one-off override possible
# without editing anything:
#
#   DEFAULT_PHP_VERSION=8.2 Build/Scripts/runTests.sh -s unit   # default is 8.5
#
# An extension that needs something this file cannot express is telling you the
# shared runner is missing a knob — add it there rather than forking the runner.

# Container network prefix and the name in `-h` output. Both are read from
# composer.json — the package name for the slug, extra.typo3/cms.extension-key
# for the label — so there is normally nothing to set here. Override only if
# the extension wants a name it does not declare anywhere.
#PROJECT_SLUG="nr-llm"
#PROJECT_LABEL="nr_llm"

# PHPUnit configurations.
#PHPUNIT_CONFIG="Build/phpunit.xml"
#PHPUNIT_FUNCTIONAL_CONFIG="Build/FunctionalTests.xml"

# Which testsuite inside those configs to run. The defaults suit the layout
# with a separate functional config: unit tests are the "unit" suite, and the
# functional config needs no selection because it is the selection. An
# extension keeping everything in one phpunit.xml names both.
#UNIT_TESTSUITE="unit"
#FUNCTIONAL_TESTSUITE="functional"

# Static analysis and refactoring configurations.
#PHPSTAN_CONFIG="Build/phpstan/phpstan.neon"
#RECTOR_CONFIG="Build/rector/rector.php"
#INFECTION_CONFIG="infection.json.dist"

# Directories the sharded functional run (`-s functionalParallel`) walks.
# This MUST cover every directory the functional PHPUnit config lists: a suite
# that is in the config but not here runs in no job and still reads as covered.
#FUNCTIONAL_PARALLEL_PATHS="Tests/Functional Tests/E2E/Backend"

# Where `-s e2e` points its browser, when TYPO3_BASE_URL is not in the
# environment. The runner starts no TYPO3 and does not care what serves this —
# a local stack, a staging system, anything answering. There is no default on
# purpose: a guessed URL means testing against whatever happens to answer.
#E2E_BASE_URL="https://your-typo3.local"

# When the target does not exist until the run creates it — an extension that
# starts its own web container per run, whose hostname carries that run's
# suffix — print the URL from a function instead. It runs after the runner's
# own setup, and TYPO3_BASE_URL from the environment still wins over it:
#
#e2e_target() {
#    start_my_stack >&2            # anything this needs, output to stderr
#    printf '%s' "http://my-web-${SUFFIX}:80"
#}

# Only when the e2e container cannot reach that URL on its own — a target
# behind another container network, a name that resolves only there. Print the
# arguments to add to the container; the runner adds nothing by itself and
# knows no environment by name. Example for a local ddev site, which lives on
# its own network:
#
#e2e_container_args() {
#    local ip
#    ip=$(${CONTAINER_BIN} inspect ddev-router \
#        --format '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' 2>/dev/null) || return 0
#    [ -n "${ip}" ] || return 0
#    printf '%s' "--network ddev_default --add-host your-typo3.ddev.site:${ip}"
#}

# Default PHP for a run without `-p`, and the Playwright image for `-s e2e`.
#DEFAULT_PHP_VERSION="8.5"
#IMAGE_PLAYWRIGHT="mcr.microsoft.com/playwright:v1.60.0-noble"

# Composer needs a root version for a package that has no tag in its own
# checkout; only change this if the extension's branch alias differs.
#COMPOSER_ROOT_VERSION="0.1.x-dev"

# A suite the shared runner does not have — rendering this extension's
# documentation, publishing coverage, installing the lowest supported
# dependency set. Define it here and `-s <name>` calls it with the remaining
# arguments; the runner's own suites always win over a function of the same
# name, so this extends rather than overrides.
#
#suite_renderDocumentation() {
#    ${CONTAINER_BIN} run ${CONTAINER_COMMON_PARAMS} --name docs-${SUFFIX} \
#        ghcr.io/typo3-documentation/render-guides:latest --config=Documentation
#}
